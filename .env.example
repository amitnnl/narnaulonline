# ==============================================================================
# NarnaulOnline Studio - Environment Configuration
# ==============================================================================
# Copy this file to .env.local to configure direct email delivery.
# If SMTP is not configured, the system automatically falls back to FormSubmit relay
# and saves inquiries to data/inquiries.json.

# Recipient Email for Inquiries
CONTACT_RECIPIENT_EMAIL=onlinenarnaul@gmail.com

# ------------------------------------------------------------------------------
# OPTION 1: Direct Gmail SMTP (Recommended for 100% reliable inbox delivery)
# ------------------------------------------------------------------------------
# Generate a 16-character App Password from Google Account:
# 1. Visit: https://myaccount.google.com/apppasswords
# 2. Select app name: "NarnaulOnline Studio"
# 3. Paste the 16-character generated password below (without spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=onlinenarnaul@gmail.com
SMTP_PASS=

# ------------------------------------------------------------------------------
# OPTION 2: Custom / Hostinger / Zoho / cPanel SMTP
# ------------------------------------------------------------------------------
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=desk@narnaulonline.com
# SMTP_PASS=your-password
